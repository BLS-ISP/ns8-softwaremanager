{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NS8 Software Center",
  "version": "1.0.0",
  "identifier": "org.nethserver.softwarecenter",
  "build": {
    "frontendDist": "./ui/dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "NS8 Software Center",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "trayIcon": {
      "id": "swm-tray",
      "tooltip": "NS8 Software Center"
    },
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:"
    }
  }
}
