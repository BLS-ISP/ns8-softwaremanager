[Unit]
Description=NS8 Software Manager Endpoint Agent
Documentation=https://github.com/NethServer/ns8-softwaremanager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=ns8-swm
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/swm-agent --data-dir /etc/ns8-swm run
Restart=always
RestartSec=10
NoNewPrivileges=false
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
