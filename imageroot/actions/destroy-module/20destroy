#!/usr/bin/env python3

import os
import subprocess
import agent

module_id = os.environ.get("MODULE_ID", "")

# Remove Traefik HTTP/HTTPS route if registered
traefik_id = agent.resolve_agent_id("traefik@node")
if traefik_id and module_id:
    agent.tasks.run(
        agent_id=traefik_id,
        action="delete-route",
        data={"instance": module_id},
    )

# Stop and disable systemd user units
subprocess.run(
    ["systemctl", "--user", "disable", "--now", "swm-app.service", "swm-db.service", "swm.service"],
    check=False,
)

# Remove persistent Podman volumes
subprocess.run(
    ["podman", "volume", "rm", "-f", "swm-db-data", "swm-app-data"],
    check=False,
)
