#!/usr/bin/env python3

import json
import os
import sys
from agent.ldapproxy import LdapDiscovery

domain_name = os.environ.get("DOMAIN_NAME", "")
lets_encrypt = os.environ.get("LETS_ENCRYPT", "false").lower() == "true"
http2https = os.environ.get("HTTP2HTTPS", "true").lower() == "true"
ldap_domain = os.environ.get("LDAP_DOMAIN", "")
admin_username = os.environ.get("ADMIN_USERNAME", "admin")
app_url = os.environ.get("APP_URL", f"https://{domain_name}" if domain_name else "")
tcp_port = int(os.environ.get("TCP_PORT", "20080"))

user_domains = []
try:
    for item in LdapDiscovery().get_domains_list():
        user_domains.append(
            {
                "name": str(item.get("name", "")),
                "schema": str(item.get("schema", "")),
            }
        )
except Exception:
    user_domains = []

config = {
    "domain_name": domain_name,
    "lets_encrypt": lets_encrypt,
    "http2https": http2https,
    "ldap_domain": ldap_domain,
    "user_domains": user_domains,
    "admin_username": admin_username,
    "app_url": app_url,
    "tcp_port": tcp_port,
    "configured": bool(domain_name),
}

json.dump(config, sys.stdout)
