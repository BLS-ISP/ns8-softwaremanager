{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "get-configuration output",
  "description": "Schema for get-configuration output",
  "type": "object",
  "required": [
    "domain_name",
    "lets_encrypt",
    "http2https",
    "ldap_domain",
    "admin_username",
    "app_url",
    "configured"
  ],
  "properties": {
    "domain_name": {
      "type": "string"
    },
    "lets_encrypt": {
      "type": "boolean"
    },
    "http2https": {
      "type": "boolean"
    },
    "ldap_domain": {
      "type": "string"
    },
    "user_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          }
        }
      }
    },
    "admin_username": {
      "type": "string"
    },
    "app_url": {
      "type": "string"
    },
    "tcp_port": {
      "type": "integer"
    },
    "configured": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
