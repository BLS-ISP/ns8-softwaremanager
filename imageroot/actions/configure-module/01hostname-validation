#!/usr/bin/env python3

import json
import os
import sys
import agent

data = json.load(sys.stdin)
domain_name = data.get("domain_name", "").strip().lower()
previous_domain = os.environ.get("DOMAIN_NAME", "").strip().lower()

if not domain_name:
    agent.set_status("validation-failed")
    json.dump(
        [
            {
                "field": "domain_name",
                "parameter": "domain_name",
                "value": domain_name,
                "error": "domain_name_required",
            }
        ],
        sys.stdout,
    )
    sys.exit(2)

if domain_name != previous_domain and agent.http_route_in_use(domain=domain_name):
    agent.set_status("validation-failed")
    json.dump(
        [
            {
                "field": "domain_name",
                "parameter": "domain_name",
                "value": domain_name,
                "error": "domain_already_used",
            }
        ],
        sys.stdout,
    )
    sys.exit(2)
